<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SunTuner</AssemblyName>
    <RootNamespace>SunTuner</RootNamespace>
    <Version>0.2.0</Version>
    <Description>PvZ Hybrid Remake sun production frequency tuner mod - Windows + Android</Description>
    <Authors>minizyz</Authors>
    <Company>minizyz</Company>
    <Product>SunTuner</Product>
    <Copyright>Copyright (c) 2026</Copyright>
    <!-- DLL 同时兼容 Windows (x64) 和 Android (arm64) BepInEx 6 -->
    <AssemblyTargetPlatform>AnyCPU</AssemblyTargetPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="6.0.0-pre.2" />
    <PackageReference Include="HarmonyX" Version="2.16.0" />
  </ItemGroup>

</Project>
